<?xml version="1.0" encoding="utf-8"?>
<!--
  A note row. The colour stripe encodes the note's hue (explicit or derived from
  its id) so a vault becomes visually navigable; the meta line carries the two
  facts that decide whether this is the note you want: when it changed and how
  long it is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <View
        android:id="@+id/colorStripe"
        android:layout_width="3dp"
        android:layout_height="34dp"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/noteEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textSize="19sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/noteExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12.5sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/noteMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.8"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notePinned"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_pin"
        app:tint="?attr/colorPrimary"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/noteStarred"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_star"
        app:tint="?attr/colorPrimary"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/noteSelected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check"
        app:tint="?attr/colorPrimary"
        android:visibility="gone"
        android:contentDescription="@string/note_selected" />

    <ImageView
        android:id="@+id/noteDragHandle"
        android:layout_width="34dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:padding="8dp"
        android:src="@drawable/ic_move"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/drag_note_to_folder" />
</LinearLayout>
