<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp"
    android:clickable="true">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/new_note_widget"
        android:textSize="15sp"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textSize="10.5sp"
        android:textColor="#AFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widgetNewNote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="＋"
            android:textSize="20sp"
            android:textColor="#FFFFFFFF"
            android:contentDescription="@string/new_note_widget" />

        <TextView
            android:id="@+id/widgetDaily"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☀"
            android:textSize="17sp"
            android:textColor="#FFFFFFFF"
            android:contentDescription="@string/nav_daily_note" />

        <TextView
            android:id="@+id/widgetTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✓"
            android:textSize="18sp"
            android:textColor="#FFFFFFFF"
            android:contentDescription="@string/nav_tasks" />
    </LinearLayout>
</LinearLayout>
