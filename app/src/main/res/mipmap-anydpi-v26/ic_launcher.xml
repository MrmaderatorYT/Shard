<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. The monochrome layer is what lets Android 13+ render a
  themed icon that follows the user's wallpaper palette; without it the system
  falls back to shrinking the whole icon into a grey blob.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
