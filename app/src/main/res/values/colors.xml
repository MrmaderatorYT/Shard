<?xml version="1.0" encoding="utf-8"?>
<!--
  Shard palette.

  Warm neutrals rather than pure greys: the surface is paper-white and the text
  is a soft near-black, which is what makes long reading and writing sessions
  comfortable. Accents are saturated but never neon, so a note's colour stripe
  reads as information rather than decoration.

  Light values live here; the dark and black variants are in values-night and in
  the Black theme overlay.
-->
<resources>

    <!-- Neutrals, light -->
    <color name="paper">#FFFFFFFF</color>
    <color name="paper_sunken">#FFF7F7F5</color>
    <color name="paper_raised">#FFFFFFFF</color>
